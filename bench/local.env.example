# Machine-specific settings of the bench. Copy to bench/local.env (gitignored)
# and fill in; the queue scripts and the leak scan read it. Never commit the
# filled-in copy.

# ssh target of the GPU workstation that runs the job queue (user@host).
JMB_HOST=user@gpu-pc
# Python 3.10+ on the PC, used by status.sh and the scheduled task
# (install.sh derives pythonw.exe from it).
JMB_PY_WIN='%LOCALAPPDATA%\Programs\Python\Python312\python.exe'
# Queue folder on the PC, in cmd and in scp notation (defaults shown).
# JMB_ROOT_WIN='D:\jmb-queue'
# JMB_ROOT_SCP='D:/jmb-queue'

# Extra words the leak scan must reject on this machine, comma separated, in
# addition to the hashed list in bench/leak-scan.json (host names, account
# names, tailnet names that are not yet in the committed list).
# LEAK_SCAN_TERMS=
